{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.exoticmoss.megabreakertools.MegaBreakerTools"
    ],
    "client": [
      "com.exoticmoss.megabreakertools.MegaBreakerToolsClient"
    ],
    "jei_mod_plugin": [
      "com.exoticmoss.megabreakertools.compat.JEIMegaBreakerToolsPlugin"
    ]
  },
  "mixins": [
    "megabreakertools.mixins.json",
    {
      "config": "megabreakertools.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "simpleores": "${simpleores_version_range}"
  },
  "suggests": {
    "jei": "*"
  }
}
